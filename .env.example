# Copy to .env (never commit .env or any keystore).
# Paths to GenLayer Studio testnet wallet keystores (JSON: {"private_key": "0x..."}).
# The buyer funds the escrow; the seller delivers. Both need a little GEN for fees.
GENLAYER_BUYER_KEYSTORE=/path/to/buyer-keystore.json
GENLAYER_SELLER_KEYSTORE=/path/to/seller-keystore.json
